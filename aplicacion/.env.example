# Copiar a .env y completar con valores reales. Nunca commitear el .env real.

SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:mysql://localhost:3306/freestyleperu?useUnicode=true&characterEncoding=utf8&serverTimezone=America/Lima
DB_USERNAME=freestyleperu
DB_PASSWORD=

# Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

SERVER_PORT=8080

# Opcional — solo si vas a controlar la suscripción desde panel-monitoreo
# (PUT /api/system/subscription). Vacía por defecto: sin ella, ese endpoint
# queda inalcanzable para cualquiera. Generar con: openssl rand -hex 24
OPS_API_KEY=

# --- Backups de MySQL (solo despliegue nativo, ver deploy/backup-mysql.sh) ---
# No los usa Spring Boot — los lee directo el script de backup.
BACKUP_RETENTION_DAYS=7
# Remote de rclone ya configurado (rclone config), ej. "b2:mi-bucket/freestyleperu".
# Vacío = el backup se queda solo en el VPS (deploy/backup-mysql.sh, BACKUP_DIR).
BACKUP_RCLONE_REMOTE=
# Vacío = el backup no se encripta. Generar con: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
