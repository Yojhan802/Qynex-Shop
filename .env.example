# Copiar a ".env" en la raíz del proyecto y completar con valores reales.
# Usado por docker-compose.yml. NUNCA subir el ".env" real al repositorio.

# --- Base de datos ---
DB_NAME=freestyleperu
DB_USERNAME=freestyleperu
DB_PASSWORD=cambiar-esta-clave
# Solo la usa el contenedor de MySQL para inicializar la instancia (usuario root).
DB_ROOT_PASSWORD=cambiar-esta-clave-root

# --- JWT (generar con: openssl rand -base64 48) ---
JWT_SECRET=cambiar-este-secreto-de-al-menos-32-caracteres
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS ---
# Dominio(s) reales desde donde se sirve el frontend en producción.
# En despliegue con docker-compose (nginx sirviendo el frontend y haciendo de
# reverse proxy a /api) el navegador solo habla con ese origen, así que CORS
# casi no entra en juego; se deja igual por si el frontend se sirve aparte.
CORS_ALLOWED_ORIGINS=http://localhost

# --- Puerto público del frontend/reverse proxy ---
HTTP_PORT=80

# --- Capacidad (opcional) ---
# Valores por defecto pensados para un VPS chico (ver perfil prod en application.yml) —
# subir estos números junto con más CPU/RAM del VPS, no antes (ver docs/08-despliegue.md).
# DB_POOL_MAX=8
# DB_POOL_MIN=2
# TOMCAT_MAX_THREADS=50
# TOMCAT_MIN_THREADS=10
# TOMCAT_ACCEPT_COUNT=100
